    subgraph WeatherApp["weather_app"]
        WAPI["Weather lookup endpoint"]
        WCACHE["django-redis cache layer\nserved_from_cache flag"]
        WRATE["django-ratelimit\nper-IP throttling -> 429"]
        WLOG["python-json-logger\nstructured logs: latency, cache hits"]
        WHEALTH["/health/\nchecks DB + Redis + external API + latency"]
